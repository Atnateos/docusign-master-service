# Copy this file to .env and fill in real values locally.
# .env is gitignored -- NEVER commit it. This file (.env.example) must only
# ever contain placeholders; app/core/config.py's validate_for_environment()
# refuses to start the app in staging/production if any of these are still
# set to a placeholder value.

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=true

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://docusign:docusign@postgres:5432/docusign_master
DATABASE_POOL_SIZE=5

# ---- DocuSign API ----
DOCUSIGN_INTEGRATION_KEY=changeme
DOCUSIGN_USER_ID=changeme
# Path to a mounted private key FILE -- not the key contents. Never put the
# PEM itself in an env var or in this file. Locally, point this at a file
# outside the repo (e.g. ./secrets/docusign_private_key.pem, which is also
# gitignored); in staging/prod this is a path to a Docker/K8s secret or a
# Vault-templated file.
DOCUSIGN_PRIVATE_KEY_PATH=changeme
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_REQUEST_TIMEOUT_SECONDS=30

# ---- Rate limiting ----
DOCUSIGN_MAX_RETRIES_ON_429=10
DOCUSIGN_DEFAULT_RETRY_AFTER_SECONDS=30

# ---- Pagination ----
DOCUSIGN_DEFAULT_PAGE_SIZE=100

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docusign
MINIO_SECURE=false

# ---- Resilience ----
EXTERNAL_CALL_MAX_RETRIES=3
EXTERNAL_CALL_RETRY_DELAYS=1,2,5
EXTERNAL_CALL_JITTER=0.5
DLQ_PAYLOAD_MAX_BYTES=16384

# ---- HMAC auth ----
HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=changeme-core-secret
HMAC_SECRET_KEY_ENGINEER=changeme-engineer-secret
HMAC_SIGNATURE_MAX_AGE=300
# JSON object mapping client_id -> role ("core" grants full access, "engineer"
# is GET-only). Client IDs are not secret; only the HMAC keys above are.
HMAC_CLIENT_CONFIG={"coordinator-dev":"core"}

# ---- Health check ----
HEALTH_CHECK_TIMEOUT_SECONDS=5
